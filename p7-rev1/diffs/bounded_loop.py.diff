+def spawn_model_suggestion(context, timeout_s=None):
+    """Run the model in a separate OS process (Priority 7). The child
+    gets a STRICT environment — exactly PATH, HOME, PYTHONPATH — and
+    communicates over stdin/stdout only: a context JSON in, a
+    suggestion JSON out. It holds no board client, no DB handle, and
+    no executor socket.
+    Revision 1 (R1): the fake-model env hooks (JSON / RAW / SLEEP)
+    are GONE from this path. The parent never copies them into the
+    child env, and the production suggest script never reads them.
+    Fake-model behaviour lives only in tests/fake_reasoning_suggest.py
+    (a test-only script driven by a file, never by env), selected by
+    monkeypatching bounded_loop.P7_SUGGEST_SCRIPT in the test.
+    The P7_MODEL_TIMEOUT_S env override is gone too: the timeout is
+    the module constant only.
+    Revision 1 (R2): the child's output is read through a BOUNDED
+    read — at most P7_MODEL_MAX_OUTPUT_BYTES + 1 bytes, in a thread
+    with the timeout; a child that writes more is killed and the
+    result is "oversized". subprocess.run (which buffers the whole
+    output before any size check) is not used.
+    Returns (suggestion_dict_or_None, reason_code_or_None,
+    adapter_output_units, latency_s). reason_code is one of the
+    adapter failure codes (timeout/empty/oversized/non-json) or None
+    on success. adapter_output_units is measured by the executor from
+    the child's output length (len // 4); a model-reported count is
+    never trusted."""
+    if classify_adapter_output is None:
+        raise RuntimeError("reasoning.py could not be imported")
+    if timeout_s is None:
+        timeout_s = P7_MODEL_TIMEOUT_S
+    # Revision 1 (R1): the child env is STRICT — exactly PATH, HOME,
+    # PYTHONPATH. No test hooks are copied in, and no timeout env
+    # override exists: the timeout is the module constant only.
+    env = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"),
+           "HOME": os.environ.get("HOME", "/tmp"),
+           "PYTHONPATH": os.path.dirname(os.path.abspath(__file__))}
+    payload = json.dumps(context).encode()
+    t0 = time.time()
+    try:
+        proc = subprocess.Popen(
+            [sys.executable, P7_SUGGEST_SCRIPT],
+            stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+            stderr=subprocess.DEVNULL, env=env)
+    except Exception:
+        return None, "model_error", 0, round(time.time() - t0, 1)
+    try:
+        proc.stdin.write(payload)
+        proc.stdin.close()
+    except (BrokenPipeError, OSError):
+        pass
+    # Revision 1 (R2): bounded read in a thread, so a child that
+    # never writes still hits the timeout. read() returns at most
+    # cap + 1 bytes: one byte over the cap proves the output is
+    # oversized without buffering all of it.
+    box = {}
+
+    def _reader():
+        try:
+            box["data"] = proc.stdout.read(P7_MODEL_MAX_OUTPUT_BYTES + 1)
+        except Exception as exc:  # noqa: BLE001 - record and classify
+            box["error"] = exc
+
+    reader = threading.Thread(target=_reader, daemon=True)
+    reader.start()
+    reader.join(timeout_s)
+    latency = round(time.time() - t0, 1)
+    if reader.is_alive():
+        try:
+            proc.kill()
+        except Exception:
+            pass
+        try:
+            proc.wait(timeout=5)
+        except Exception:
+            pass
+        return None, classify_adapter_output(None, timed_out=True), 0, latency
+    if "error" in box:
+        try:
+            proc.kill()
+        except Exception:
+            pass
+        return None, "model_error", 0, latency
+    out = box.get("data") or b""
+    if len(out) > P7_MODEL_MAX_OUTPUT_BYTES:
+        # The child wrote past the cap: kill it (it may still be
+        # writing) and report oversized without reading further.
+        try:
+            proc.kill()
+        except Exception:
+            pass
+        try:
+            proc.wait(timeout=5)
+        except Exception:
+            pass
+        return None, "oversized", (P7_MODEL_MAX_OUTPUT_BYTES
+                                   // P7_ADAPTER_OUTPUT_UNIT), latency
+    try:
+        proc.wait(timeout=5)
+    except Exception:
+        try:
+            proc.kill()
+        except Exception:
+            pass
+        return None, classify_adapter_output(None, timed_out=True), 0, latency
+    units = len(out) // P7_ADAPTER_OUTPUT_UNIT
+    code = classify_adapter_output(out)
+    if code is not None:
+        return None, code, units, latency
+    try:
+        result = json.loads(out.decode())
+    except (ValueError, UnicodeDecodeError):
+        return None, "non-json", units, latency
+    if not isinstance(result, dict):
+        return None, "non-json", units, latency
+    if result.get("reason_code"):
+        return None, result["reason_code"], units, latency
+    suggestion = result.get("suggestion")
+    if not isinstance(suggestion, dict):
+        return None, "non-json", units, latency
+    return suggestion, None, units, latency
+
