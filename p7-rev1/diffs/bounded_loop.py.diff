+def _p7_reason_run(api, run_id, fh, items, entries, lessons, open_jobs,
+                   rec, no_reply, include_pilot, cooled_by_job, pick,
+                   tier, remaining):
+    """Priority 7 run path (api-42, --p7 --reason). The deterministic
+    gates and candidate filter already ran in run_once; this function
+    owns the server run lifecycle:
+      1. refuse to start while an UNKNOWN_OUTCOME run is open
+      2. create the server run (mode live only when the loop is live)
+      3. trace memory_loaded / goal_proposed
+      4. NO_ACTION path when there is no candidate (no model call)
+      5. spawn the model subprocess, validate the suggestion
+      6. reject permission-seeking goals (contract test 7)
+      7. trace plan_*/action_authorized, execute via /action (live)
+         or record the dry-run intent, evaluate, complete
+    The model subprocess holds no credential; the executor (this
+    process) holds the resident token + the per-run executor token.
+    Trace payloads carry ids/hashes/counts only — never job text,
+    memory content, or model prose (canary rule)."""
+    rec["p7"] = True
+    mode = "live" if not api.dry_run else "dry_run"
+    # (1) UNKNOWN_OUTCOME lock: the next wake is blocked until the
+    # stuck run is reconciled by hand. No model call, no claim.
+    s, runs = api.list_runs()
+    if s == 200:
+        for r in runs.get("runs", []):
+            if r.get("status") == "UNKNOWN_OUTCOME":
+                rec["decision"] = "noop"
+                rec["reason"] = ("unknown_outcome_blocked: run "
+                                 + r["id"] + " needs reconciliation")
+                log_line(rec["reason"], fh)
+                return rec
+    # (2) create the run
+    s, run = api.create_run(f"p7-{run_id}", mode=mode,
+                            allowlist=["claim_job"], cooldown_ms=60000,
+                            policy_version=P7_POLICY_VERSION)
+    if s == 409 and run.get("error") in ("lease_already_open",
+                                         "unknown_outcome_blocked",
+                                         "cooldown_active"):
+        rec["decision"] = "noop"
+        rec["reason"] = f"run not started: {run.get('error')}"
+        log_line(rec["reason"], fh)
+        return rec
+    if s not in (200, 201):
+        rec["decision"] = "noop"
+        rec["reason"] = f"run create failed: HTTP {s} {run}"
+        log_line(rec["reason"], fh)
+        return rec
+    run_id_srv = run["id"]
+    fencing = run["fencing_token"]
+    exec_token = run.get("executor_token")  # present on 201 only
+    rec["p7_run"] = {"id": run_id_srv, "mode": mode,
+                     "fencing_token": fencing}
+    if exec_token is None:
+        # Idempotent replay: the token was shown once, at creation.
+        # The run cannot act without it; treat as a blocked run.
+        rec["decision"] = "noop"
+        rec["reason"] = "run replayed without executor token; cannot act"
+        log_line(rec["reason"], fh)
+        return rec
+
+    def _ev(event_type, payload):
+        es, eb = api.append_run_event(run_id_srv, event_type, fencing,
+                                      payload, exec_token=exec_token)
+        if es != 201:
+            log_line(f"run event {event_type} failed: HTTP {es} {eb}", fh)
+        return es, eb
+
+    # (3) memory loaded (seqs + types only — never content)
+    _ev("memory_loaded", {"entries": len(entries),
+                          "seqs": [e.get("seq") for e in entries[-10:]]})
+    # (4) no candidate -> NO_ACTION (no model call, no claim, no spend)
+    if pick is None:
+        _ev("goal_proposed", {"goal": None})
+        _ev("no_action", {"reason": "no_candidates"})
+        cs, cb = api.complete_run(run_id_srv)
+        rec["decision"] = "noop"
+        rec["reason"] = "no matching open job (P7 NO_ACTION)"
+        log_line(f"P7 NO_ACTION run {run_id_srv} completed: HTTP {cs}", fh)
+        return rec
+    jid = pick["id"]
+    _ev("goal_proposed", {"goal": {"ref": jid, "kind": "claim_job"}})
+    # (5) model. In dry-run mode the model adapter is NEVER invoked
+    # (contract dry-run rule, P7-12): the plan is the deterministic
+    # pick, traced as source "deterministic". The model subprocess
+    # runs only in live mode.
+    if mode == "dry_run":
+        source = "deterministic"
+        rec["reasoning"] = {"called": False, "fallback": False,
+                            "reason_code": "", "output_units": 0,
+                            "latency_s": None,
+                            "reason": "dry-run: no model call"}
+        adapter_output_units = 0
+    else:
+        candidates = [j for j in open_jobs
+                      if j.get("id") not in set(cooled_by_job)
+                      and job_matches(j, include_pilot=include_pilot)
+                      and RESIDENT_ID not in (j.get("claimed_by") or [])
+                      and veto_key(j.get("title"), j.get("created_by"))
+                      not in lessons]
+        # Revision 1 (R4): the model gets ids and structure only —
+        # never memory content, job briefs, or wake payloads. Wake
+        # items shrink to wake_id + event_type, memory entries to seq
+        # + type, candidates to id + title (titles are public board
+        # text; briefs are excluded). Lessons are already structured
+        # {key, job_id} pairs.
+        context = {"resident_id": RESIDENT_ID,
+                   "wake": [{"wake_id": it.get("wake_id"),
+                             "event_type": it.get("event_type")}
+                            for it in items],
+                   "memory": [{"seq": e.get("seq"), "type": e.get("type")}
+                              for e in entries],
+                   "candidates": [{"id": j.get("id"),
+                                   "title": j.get("title")}
+                                  for j in candidates],
+                   "lessons": sorted(lessons.values())}
+        suggestion, reason_code, adapter_output_units, latency =             spawn_model_suggestion(context)
+        if reason_code is not None:
+            # Adapter failure: explicit reason code, BLOCKED, never a
+            # claim or an action. The plan_rejected event already
+            # moves the run to BLOCKED (and anchors the chain); the
+            # /block below is a safety net if the append failed.
+            es, _eb = _ev("plan_rejected", {"reason_code": reason_code,
+                                            "adapter_output_units": adapter_output_units})
+            if es != 201:
+                bs, bb = api.block_run(run_id_srv, reason_code)
+                log_line(f"P7 adapter failure {reason_code}; run blocked: "
+                         f"HTTP {bs}", fh)
+            else:
+                log_line(f"P7 adapter failure {reason_code}; run blocked "
+                         f"by plan_rejected", fh)
+            rec["decision"] = "noop"
+            rec["reason"] = f"model adapter failed: {reason_code}"
+            rec["reasoning"] = {"called": True, "fallback": True,
+                                "reason_code": reason_code,
+                                "output_units": adapter_output_units,
+                                "latency_s": latency}
+            return rec
+        rec["reasoning"] = {"called": True, "fallback": False,
+                            "output_units": adapter_output_units, "latency_s": latency}
+        # Validate the suggestion against the ids actually shown. An
+        # invalid suggestion falls back to the deterministic pick (the
+        # Priority 6 contract); only a transport/format failure gets
+        # a reason code.
+        shown_ids = {j.get("id") for j in candidates}
+        shown_wake = {it.get("wake_id") for it in items}
+        shown_seqs = {e.get("seq") for e in entries}
+        errors = validate_deliberation(suggestion, shown_ids, shown_wake,
+                                       shown_seqs)
+        source = "model"
+        if errors:
+            log_line(f"P7 suggestion invalid ({'; '.join(errors)}); "
+                     f"deterministic fallback", fh)
+            rec["reasoning"]["fallback"] = True
+            rec["reasoning"]["fallback_reason"] = "; ".join(errors)
+            source = "deterministic_fallback"
+            suggestion = {"chosen_job_id": jid, "goals": [],
+                          "declined_job_id": None, "decline_reason": ""}
+        # Decline: the model declined the pick; take the next candidate
+        # or NO_ACTION when nothing remains.
+        declined_id = suggestion.get("declined_job_id")
+        chosen_id = suggestion.get("chosen_job_id")
+        if declined_id and not chosen_id and declined_id == jid:
+            rest = [j for j in candidates if j.get("id") != declined_id]
+            if not rest:
+                _ev("no_action", {"reason": "declined_per_reasoning",
+                                  "job_id": declined_id})
+                api.complete_run(run_id_srv)
+                rec["decision"] = "noop"
+                cat = _decline_category(suggestion.get("decline_reason", ""))
+                rec["reason"] = (f"declined per reasoning: "
+                                 f"{suggestion.get('decline_reason', '')}")
+                rec["declined"].append(
+                    {"job_id": declined_id, "title": pick.get("title"),
+                     "lesson_seq": None,
+                     "reason": suggestion.get("decline_reason", ""),
+                     "category": cat})
+                now_iso = datetime.now(timezone.utc).isoformat()
+                outcome = (f"Run {run_id}: no action. Reason: "
+                           f"{_decline_summary(suggestion.get('decline_reason', ''))}. "
+                           f"Wake items: {len(items)}. Lessons consulted: "
+                           f"{rec['lessons_consulted'] or 'none'}. "
+                           f"{_decline_marker(declined_id, cat, now_iso)}. "
+                           f"{_evidence_text(rec.get('reasoning'))}")
+                rec["outcome_seq"] = _append_outcome(api, outcome, fh)
+                return rec
+            jid = rest[0]["id"]
+            pick = rest[0]
+            _ev("goal_proposed", {"goal": {"ref": jid, "kind": "claim_job"}})
+        elif isinstance(chosen_id, str) and chosen_id in shown_ids:
+            jid = chosen_id
+            for j in candidates:
+                if j.get("id") == jid:
+                    pick = j
+                    break
+        # (6) permission-seeking goals are rejected outright.
+        goal_texts = [str(g.get("text") or "")
+                      for g in (suggestion.get("goals") or [])
+                      if isinstance(g, dict)]
+        low = " ".join(goal_texts).lower()
+        if any(p in low for p in _P7_PERMISSION_GOAL_PATTERNS):
+            es, _eb = _ev("plan_rejected",
+                          {"reason_code": "permission_goal"})
+            if es != 201:
+                api.block_run(run_id_srv, "permission_goal")
+            rec["decision"] = "noop"
+            rec["reason"] = "permission-seeking goal rejected"
+            log_line("P7 permission goal rejected; run blocked", fh)
+            return rec
+    _ev("goal_accepted", {"goal": {"ref": jid}})
+    _ev("plan_proposed", {"plan": {"action": {"type": "claim_job",
+                                              "job_id": jid}},
+                          "source": source,
+                          "adapter_output_units": adapter_output_units})
+    _ev("plan_accepted", {"plan": {"action": {"type": "claim_job",
+                                              "job_id": jid}}})
+    _ev("action_authorized", {"action": {"type": "claim_job",
+                                         "job_id": jid}})
+    if mode == "dry_run":
+        _ev("evaluation_recorded", {"dry_run": True, "would_claim": jid})
+        api.complete_run(run_id_srv)
+        rec["decision"] = "claim"
+        rec["action"] = {"kind": "claim", "job_id": jid,
+                         "title": pick.get("title"), "dry_run": True}
+        rec["reason"] = "dry-run: would claim " + jid
+        log_line(f"[dry-run] would claim {jid} '{pick.get('title')}'", fh)
+        sig = json.dumps({"job_id": jid})
+        outcome = (f"claimed {sig} — rule: "
+                   f"{'reasoning' if source == 'model' else 'deterministic'}; "
+                   f"validator: {'ok' if source == 'model' else 'fallback'}; "
+                   f"wake items: {len(items)}. "
