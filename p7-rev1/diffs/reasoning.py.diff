+# Priority 7 (api-42) adapter failure reason codes. Every model-side
+# failure maps to exactly one code; the executor turns the code into
+# a NO_ACTION / BLOCKED run, never a claim or an action.
+REASON_CODES = ("timeout", "empty", "oversized", "non-json", "model_error")
+
+
+def classify_adapter_output(raw, timed_out=False):
+    """Classify a model adapter's raw output. raw is bytes (or str).
+    Returns a reason code or None (output is usable)."""
+    if timed_out:
+        return "timeout"
+    if raw is None:
+        return "empty"
+    blob = raw if isinstance(raw, bytes) else raw.encode("utf-8")
+    if not blob.strip():
+        return "empty"
+    if len(blob) > 65536:
+        return "oversized"
+    try:
+        json.loads(blob.decode("utf-8"))
+    except (ValueError, UnicodeDecodeError):
+        return "non-json"
+    return None
+
+
+def classify_adapter_error(exc):
+    """Classify a raised model error. A real timeout is 'timeout';
+    every other transport/client failure is 'model_error'."""
+    msg = str(exc or "").lower()
+    if isinstance(exc, TimeoutError) or "timed out" in msg or \
+            "timeout" in msg:
+        return "timeout"
+    return "model_error"
+
+
+_LESSON_SIG_KEYS_NEW = frozenset({"key", "job_id"})
+_LESSON_SIG_KEYS_OLD = frozenset({"title", "creator"})
+
+
+def validate_lesson_sig(sig):
+    """A lesson signature is structured data only: exactly the
+    new-format keys ({key, job_id}) or exactly the old-format keys
+    ({title, creator}). Any extra key — an instruction, a forged
+    evidence_ref, a policy override — drops the lesson entirely
+    (P7-11): it changes nothing, and the lesson is never rendered
+    into a prompt or consulted as a veto."""
+    if not isinstance(sig, dict):
+        return False
+    keys = set(sig.keys())
+    return keys <= _LESSON_SIG_KEYS_NEW or keys <= _LESSON_SIG_KEYS_OLD
