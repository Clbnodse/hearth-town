-# ---- game-api MCP + OpenAPI (20261114-game-api-41, additive only) --------
+# ---- game-api Priority 7 runs (20261114-game-api-42, additive only) --------
+# Priority 7 (formal proposal; revised contract msg-924d7cb2, adopted
+# msg-c6c2e7a0): the server-side BRAIN interface. A reasoning resident
+# (Ember first) works through a RUN record: the model runs in a separate
+# OS process with NO credential, and the executor (the resident's agent
+# process) holds the only per-run allowlist-scoped token, minted by the
+# server. Every step is written to a per-resident append-only trace
+# (hash-chained SQLite, one file per resident) and the chain head is
+# anchored into the public event log at completion/block/expire, so the
+# trace is tamper-evident outside the runner's write authority.
+# Reasoning stays OFF until the owner approves a live run; this slice
+# adds the interface + tests only. No finance rails, no game HTML
+# changes, no MCP tools added (41 tools, unchanged).
+import secrets as _p7_secrets
+
+_P7_VERSION = "20261114-game-api-42"
+_P7_RUN_STATES = ("IDLE", "LEASED", "CONTEXT_LOADED", "GOAL_SELECTED",
+                  "PLAN_VALIDATED", "ACTION_AUTHORIZED", "ACTION_STARTED",
+                  "ACTION_EXECUTED", "EVALUATED", "MEMORY_APPENDED",
+                  "NO_ACTION", "UNKNOWN_OUTCOME", "COMPLETE", "BLOCKED",
+                  "EXPIRED")
+_P7_TERMINAL_STATES = {"COMPLETE", "BLOCKED", "EXPIRED"}
+# Trace events the executor may append via POST .../events (the
+# planning-phase events). action_started / action_result are written
+# by the server inside POST .../action only; run_completed /
+# run_blocked / run_expired are written by their own endpoints only.
+_P7_RUN_EVENT_TYPES = ("run_created", "lease_claimed", "memory_loaded",
+    "goal_proposed", "goal_accepted", "no_action", "plan_proposed",
+    "plan_rejected", "plan_accepted", "action_authorized", "action_started",
+    "action_result", "evaluation_recorded", "lesson_appended",
+    "run_completed", "run_blocked", "run_expired", "run_kill_switch")
+_P7_CLIENT_EVENT_TYPES = ("lease_claimed", "memory_loaded",
+    "goal_proposed", "goal_accepted", "no_action", "plan_proposed",
+    "plan_rejected", "plan_accepted", "action_authorized",
+    "evaluation_recorded", "lesson_appended")
+_P7_EVENT_TO_STATE = {
+    "run_created": "LEASED",
+    "lease_claimed": "LEASED",
+    "memory_loaded": "CONTEXT_LOADED",
+    "goal_proposed": "GOAL_SELECTED",
+    "goal_accepted": "GOAL_SELECTED",
+    "no_action": "NO_ACTION",
+    "plan_proposed": "PLAN_VALIDATED",
+    "plan_rejected": "BLOCKED",
+    "plan_accepted": "PLAN_VALIDATED",
+    "action_authorized": "ACTION_AUTHORIZED",
+    "action_started": "ACTION_STARTED",
+    "action_result": "ACTION_EXECUTED",
+    "evaluation_recorded": "EVALUATED",
+    "lesson_appended": "MEMORY_APPENDED",
+    "run_completed": "COMPLETE",
+    "run_blocked": "BLOCKED",
+    "run_expired": "EXPIRED",
+}
+_P7_ALLOWED_TRANSITIONS = {
+    "IDLE": {"run_created"},
+    "LEASED": {"lease_claimed", "memory_loaded"},
+    "CONTEXT_LOADED": {"goal_proposed"},
+    "GOAL_SELECTED": {"goal_accepted", "no_action", "plan_proposed",
+                      "plan_rejected"},
+    "PLAN_VALIDATED": {"plan_accepted", "plan_rejected", "action_authorized"},
