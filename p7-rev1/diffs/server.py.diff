+def _p7_list_runs(data, agent, resident_id):
+    if _econ_find_resident(data, resident_id) is None:
+        return 404, {"error": "resident not found"}
+    # Revision 1 (S1): muse/owner may act on any resident's run
+    # for reconcile (and the reads a reconcile needs).
+    if agent not in ("muse", "owner") and not _econ_may_act_as(
+            agent, resident_id, data):
+        return 403, {"error": "token_not_bound_to_resident",
+                     "resident_id": resident_id}
+    runs = [r for r in data.get("runs", {}).values()
+            if r.get("resident_id") == resident_id]
+    runs.sort(key=lambda r: r.get("created_at", ""), reverse=True)
+    return 200, {"resident_id": resident_id,
+                 "runs": [_p7_run_view(r) for r in runs[:50]]}
+
+
+def _p7_get_run(data, agent, resident_id, run_id):
+    if _econ_find_resident(data, resident_id) is None:
+        return 404, {"error": "resident not found"}
+    # Revision 1 (S1): muse/owner may act on any resident's run
+    # for reconcile (and the reads a reconcile needs).
+    if agent not in ("muse", "owner") and not _econ_may_act_as(
+            agent, resident_id, data):
+        return 403, {"error": "token_not_bound_to_resident",
+                     "resident_id": resident_id}
+    run = _p7_find_run(data, resident_id, run_id)
+    if run is None:
+        return 404, {"error": "run not found"}
+    if _p7_maybe_expire(data, run):
+        _game_api_save(data)
+    return 200, _p7_run_view(run)
+
+
+def _p7_list_run_events(data, agent, resident_id, run_id):
+    if _econ_find_resident(data, resident_id) is None:
+        return 404, {"error": "resident not found"}
+    # Revision 1 (S1): muse/owner may act on any resident's run
+    # for reconcile (and the reads a reconcile needs).
+    if agent not in ("muse", "owner") and not _econ_may_act_as(
+            agent, resident_id, data):
+        return 403, {"error": "token_not_bound_to_resident",
+                     "resident_id": resident_id}
+    run = _p7_find_run(data, resident_id, run_id)
+    if run is None:
+        return 404, {"error": "run not found"}
+    store = _P7RunStore(resident_id)
+    try:
+        events = store.list_events(run_id)
+        ok, head, count = store.verify(run_id)
+    finally:
+        store.close()
+    return 200, {"resident_id": resident_id, "run_id": run_id,
+                 "events": events, "chain_ok": ok, "head_hash": head,
+                 "count": count}
+
+
+def _p7_append_event(data, agent, digest, resident_id, run_id, body, handler):
+    if not _econ_write_ok(digest):
+        return 429, {"error": "rate limit", "retry_after_seconds": 60}
+    if _econ_find_resident(data, resident_id) is None:
+        return 404, {"error": "resident not found"}
+    run = _p7_find_run(data, resident_id, run_id)
+    if run is None:
+        return 404, {"error": "run not found"}
+    # Caller auth: the resident's own token, muse, owner, or the run's
+    # executor token. Any other agent gets 403 with no content.
+    authed = _econ_may_act_as(agent, resident_id, data)
+    if not authed:
+        _a, err = _p7_executor_auth(data, run, handler)
+        authed = err is None
+    if not authed:
+        return 403, {"error": "token_not_bound_to_resident",
+                     "resident_id": resident_id}
+    if _p7_maybe_expire(data, run):
+        _game_api_save(data)
+        return 409, {"error": "run_expired", "detail": "lease expired"}
+    event_type = str(body.get("event_type", "")).strip()
+    if event_type not in _P7_CLIENT_EVENT_TYPES:
+        return 400, {"error": "event type " + event_type +
+                     " is not appendable here; use the matching endpoint"}
+    if not _p7_transition_allowed(run, event_type):
+        return 409, {"error": "invalid_run_transition",
+                     "detail": "cannot record " + event_type + " from "
+                     + str(run.get("status"))}
+    # Fencing: the append must carry the run's current fencing token.
+    if body.get("fencing_token") != run.get("fencing_token"):
+        return 409, {"error": "fencing_stale",
+                     "detail": "fencing token does not match this run"}
+    payload = body.get("payload")
+    if payload is None:
+        payload = {}
+    if not isinstance(payload, dict):
+        return 400, {"error": "payload must be an object"}
+    # Revision 1 (S7): the payload must match its event-type schema.
+    # "Policy authorizes" is no longer client-asserted: unknown keys,
+    # free text, and oversized values are refused here, at the server
+    # boundary. A planted canary string cannot enter the trace.
+    ok, err = _p7_validate_event_payload(event_type, payload)
+    if not ok:
+        return 400, {"error": "event_payload_invalid", "detail": err}
+    # Revision 1 (S7/R5), refined in testing: a reported adapter
+    # output-unit count is CLAMPED to the run's own max_model_tokens
+    # cap and the remaining daily budget — never rejected. Rejecting
+    # broke legitimate traces: an oversized model output measures
+    # cap // 4 = 16384 units, far above a run's 2000-unit cap, and
+    # the plan_rejected event carrying it could not be appended at
+    # all (P7-14). The server cannot recompute the model's output
+    # length, but it never charges more than the caps. The clamped
+    # value is written back into the payload so the trace records
+    # what was actually charged.
+    if "adapter_output_units" in payload:
+        spend_now = _p7_spend(data, resident_id)
+        remaining = _P7_DEFAULT_DAILY_OUTPUT_UNITS - int(
+            spend_now.get("output_units_today") or 0)
+        payload["adapter_output_units"] = max(0, min(
+            payload["adapter_output_units"],
+            int(run.get("max_model_tokens") or 0), remaining))
+    # Revision 1 (S7): the server derives the evaluation from the
+    # stored action_result instead of trusting the client's claim.
+    # A live evaluation must match a recorded action_result; a dry-run
+    # evaluation (dry_run: true) needs none.
+    if event_type == "evaluation_recorded" and not payload.get("dry_run"):
+        store = _P7RunStore(resident_id)
+        try:
+            trace = store.list_events(run_id)
+        finally:
+            store.close()
+        results = [e for e in trace
+                   if e.get("event_type") == "action_result"]
+        claimed = payload.get("outcome")
+        ref = payload.get("action_result_event_id")
+        if ref is not None:
+            if not any(e.get("event_id") == ref for e in results):
+                return 409, {"error": "evaluation_mismatch",
+                             "detail": "action_result_event_id is not a "
+                             "recorded action_result"}
+        if not results:
+            return 409, {"error": "evaluation_mismatch",
+                         "detail": "no action_result recorded yet"}
+        committed = bool((results[-1].get("payload") or {}).get("committed"))
+        if claimed == "executed" and not committed:
+            return 409, {"error": "evaluation_mismatch",
+                         "detail": "evaluation claims executed but the "
+                         "stored action_result did not commit"}
+        if claimed in ("failed", "rejected") and committed:
+            return 409, {"error": "evaluation_mismatch",
+                         "detail": "evaluation claims failure but the "
+                         "stored action_result committed"}
+    # resident_id comes from the lease, never the body: force it
+    # (the raw store below still refuses a mismatched value when
+    # called directly — see P7-08).
+    payload["resident_id"] = resident_id
+    # Adapter output-unit accounting (R5): the executor reports what
+    # IT measured (adapter_output_units = child output length // 4).
+    # A model-reported token count (model_tokens) is never read and
+    # never trusted — see P7-10. The units are clamped to the run's
+    # max_model_tokens cap and the remaining daily budget (above).
+    adapter_output_units = payload.get("adapter_output_units")
+    if isinstance(adapter_output_units, int) and adapter_output_units > 0:
+        spend = _p7_spend(data, resident_id)
+        spend["output_units_today"] = int(spend.get("output_units_today") or 0) + adapter_output_units
+        run["adapter_output_units_used"] = int(run.get("adapter_output_units_used") or 0) + adapter_output_units
+    store = _P7RunStore(resident_id)
+    try:
+        ev = store.append(run_id, event_type, payload)
+    except _P7AppendOnlyViolation as exc:
+        return 403, {"error": "storage_isolation", "detail": str(exc)}
+    finally:
+        store.close()
+    new_status = _P7_EVENT_TO_STATE.get(event_type)
+    if new_status:
+        run["status"] = new_status
+    # A plan_rejected event carries its reason code onto the run
+    # record (it is the terminal event for that run).
+    if event_type == "plan_rejected" and isinstance(payload.get("reason_code"), str):
+        run["reason_code"] = payload["reason_code"]
+    run["updated_at"] = _econ_now()
+    # Revision 1 (S8): anchor the chain head on EVERY append, not
+    # only at terminal states, so a tampered non-terminal trace is
+    # detectable the moment it is read back.
+    anchor = _p7_anchor_chain_head(data, run)
+    _game_api_save(data)
+    out = {"event": ev, "run": _p7_run_view(run)}
+    if anchor is not None:
+        out["chain_anchor"] = anchor
+    return 201, out
+
+
+def _p7_run_action(data, agent, digest, resident_id, run_id, body, handler):
+    """The single atomic step of the whole interface. Under
+    _game_api_lock (held by the dispatcher for the whole request) this
+    does, in order, with no gap: authenticate the executor token,
+    re-read the kill switch, check fencing + lease + state, write the
+    INTENT record (action_started + adapter charge) and SAVE it, then
+    perform the action, write action_result, charge the action, and
+    save. Revision 1 (S6): the intent save before the claim closes
+    the crash window — a death after the save leaves a trace the
+    startup reconcile can resolve. Revision 1 (S3): a known refusal
+    (any non-200 from the claim core) is BLOCKED/action_rejected,
+    not UNKNOWN_OUTCOME; only an exception (no result at all) is
+    truly unknown. There is no window in which a kill-switch flip
+    or a fencing change can land between the check and the commit —
+    the flip is a separate request that must wait for the lock, and
+    the flip is re-read here, inside the lock, after the flip's own
+    write."""
+    if not _econ_write_ok(digest):
+        return 429, {"error": "rate limit", "retry_after_seconds": 60}
+    if _econ_find_resident(data, resident_id) is None:
+        return 404, {"error": "resident not found"}
+    run = _p7_find_run(data, resident_id, run_id)
+    if run is None:
+        return 404, {"error": "run not found"}
+    # Executor token ONLY. The resident token is explicitly not enough
+    # here: a compromised model process holds no token at all, and a
+    # leaked resident token cannot execute a run action.
+    _a, err = _p7_executor_auth(data, run, handler)
+    if err is not None:
+        return 403, err
+    if _p7_maybe_expire(data, run):
+        _game_api_save(data)
+        return 409, {"error": "run_expired", "detail": "lease expired"}
+    if run.get("status") != "ACTION_AUTHORIZED":
+        return 409, {"error": "invalid_run_transition",
+                     "detail": "action requires ACTION_AUTHORIZED, run is "
+                     + str(run.get("status"))}
+    if body.get("fencing_token") != run.get("fencing_token"):
+        return 409, {"error": "fencing_stale",
+                     "detail": "fencing token does not match this run"}
+    # Kill switch, re-read INSIDE the lock, in the same step as the
+    # action_started write below. A flip that lands before this read
+    # blocks the action; a flip after it cannot undo the commit.
+    if _p7_kill_switch_on(data):
+        _econ_event(data, "resident:" + resident_id, "run.kill_switch",
+                    {"run_id": run_id, "resident_id": resident_id,
+                     "blocked": "action"}, None)
+        _game_api_save(data)
+        return 403, {"error": "kill_switch_on",
+                     "detail": "Priority 7 runs are halted"}
+    action = body.get("action")
+    if not isinstance(action, dict):
+        return 400, {"error": "action must be an object"}
+    action_type = str(action.get("type", "")).strip()
+    if action_type not in run.get("allowlist", []):
+        return 403, {"error": "action_not_in_allowlist",
+                     "detail": action_type + " is not in this run's "
+                     "allowlist"}
+    if run.get("mode") == "dry_run":
+        return 409, {"error": "mode_dry_run",
+                     "detail": "this run is dry_run; no action executes"}
+    if int(run.get("actions_taken") or 0) >= int(run.get("max_actions") or 1):
+        return 409, {"error": "run_action_limit",
+                     "detail": "this run already took its action"}
+    spend = _p7_spend(data, resident_id)
+    if int(spend.get("actions_today") or 0) >= _P7_DEFAULT_DAILY_ACTIONS:
+        return 429, {"error": "budget_exceeded",
+                     "detail": "daily run action cap reached"}
+    # Revision 1 (R5), refined in testing: the reported adapter
+    # output-unit count is validated, not trusted — it must be an
+    # int >= 0 — and then CLAMPED to the run's own max_model_tokens
+    # cap and the remaining daily budget (same rule as event
+    # appends). The plan and the action report the same measurement;
+    # rejecting here after clamping there would leave a run that
+    # can plan but never act (P7-14). It is an output-size estimate,
+    # len // 4 — not a measured token count; the server bounds it,
+    # it cannot recompute it.
+    adapter_output_units = body.get("adapter_output_units")
+    if (not isinstance(adapter_output_units, int)
+            or isinstance(adapter_output_units, bool)
+            or adapter_output_units < 0):
+        return 400, {"error": "adapter_output_units_invalid",
+                     "detail": "adapter_output_units must be an int >= 0"}
+    adapter_output_units = max(0, min(
+        adapter_output_units, int(run.get("max_model_tokens") or 0),
+        _P7_DEFAULT_DAILY_OUTPUT_UNITS
+        - int(spend.get("output_units_today") or 0)))
+    # Perform the action. claim_job reuses the one claim path
+    # (_econ_claim_job_core) so a run claim is identical to a direct
+    # claim, with the same tier/binding/deadline checks.
+    store = _P7RunStore(resident_id)
+    try:
+        # Revision 1 (S6): the INTENT record is written and SAVED
+        # before the claim executes. The adapter charge lands here
+        # too, so a crash after this save is charged exactly once and
+        # the startup reconcile can resolve the run from its trace.
+        store.append(run_id, "action_started",
+                     {"action_type": action_type,
+                      "fencing_token": run.get("fencing_token"),
+                      "kill_switch_read_at": _econ_now(),
+                      "kill_switch_on": False})
+        run["status"] = "ACTION_STARTED"
+        run["adapter_output_units_used"] = int(
+            run.get("adapter_output_units_used") or 0) + adapter_output_units
+        spend["output_units_today"] = int(
+            spend.get("output_units_today") or 0) + adapter_output_units
+        run["updated_at"] = _econ_now()
+        _game_api_save(data)
+        # Execute the claim. The claim core returns normally for every
+        # known refusal (409/403/404/400/429): the claim did not
+        # commit, so the run is BLOCKED with action_rejected (S3).
+        # Only an exception — no result at all — is truly unknown.
+        try:
+            if action_type == "claim_job":
+                job_id = str(action.get("job_id", "")).strip()
+                idem = ("run:" + run_id + ":"
+                        + str(action.get("idempotency_key", "")))
+                code, result = _econ_claim_job_core(
+                    data, agent, job_id,
+                    {"resident_id": resident_id, "idempotency_key": idem},
+                    digest)
+                committed = code == 200
+                outcome = "executed" if committed else "rejected"
+                result_obj = result
+            elif action_type == "noop":
+                code, result_obj, committed, outcome = (
+                    200, {"noop": True}, True, "executed")
+            else:  # unreachable: the allowlist check above
+                code, result_obj, committed, outcome = (
+                    400, {"error": "unknown action"}, False, "rejected")
+        except Exception as exc:
+            # No result at all: the claim may or may not have
+            # committed. Lock the run UNKNOWN_OUTCOME for a human
+            # (muse/owner) to reconcile; there is no automatic retry.
+            store.append(run_id, "action_result",
+                         {"action_type": action_type, "outcome": "unknown",
+                          "committed": False,
+                          "error": {"error": "executor_exception",
+                                    "detail": str(exc)[:200]},
+                          "adapter_output_units": adapter_output_units})
+            run["status"] = "UNKNOWN_OUTCOME"
+            run["reason_code"] = "unknown_outcome"
+            run["updated_at"] = _econ_now()
+            _game_api_save(data)
+            return 500, {"error": "action_outcome_unknown",
+                         "detail": "the action may or may not have "
+                         "committed; run is UNKNOWN_OUTCOME",
+                         "run": _p7_run_view(run)}
+        store.append(run_id, "action_result",
+                     {"action_type": action_type, "outcome": outcome,
+                      "committed": committed,
+                      "result": result_obj if committed else None,
+                      "error": result_obj if not committed else None,
+                      "adapter_output_units": adapter_output_units})
+        if committed:
+            run["status"] = "ACTION_EXECUTED"
+            run["actions_taken"] = int(run.get("actions_taken") or 0) + 1
+            spend["actions_today"] = int(spend.get("actions_today") or 0) + 1
+            spend["last_action_at"] = _econ_now()
+        else:
+            # Known refusal: the claim did not commit. The run is
+            # BLOCKED with action_rejected (S3) — it is not stuck,
+            # and a new run may start immediately. The adapter units
+            # were already charged at intent time (the model ran).
+            run["status"] = "BLOCKED"
+            run["reason_code"] = "action_rejected"
+        run["updated_at"] = _econ_now()
+        _game_api_save(data)
+        if committed:
+            return 200, {"run": _p7_run_view(run), "outcome": outcome,
+                         "result": result_obj}
+        return code, {"error": "action_not_committed", "outcome": outcome,
+                      "run": _p7_run_view(run), "result": result_obj}
+    finally:
+        store.close()
+
+
+def _p7_complete_run(data, agent, resident_id, run_id, body):
+    if _econ_find_resident(data, resident_id) is None:
+        return 404, {"error": "resident not found"}
+    # Revision 1 (S1): muse/owner may act on any resident's run
+    # for reconcile (and the reads a reconcile needs).
+    if agent not in ("muse", "owner") and not _econ_may_act_as(
+            agent, resident_id, data):
+        return 403, {"error": "token_not_bound_to_resident",
+                     "resident_id": resident_id}
+    run = _p7_find_run(data, resident_id, run_id)
+    if run is None:
+        return 404, {"error": "run not found"}
+    if _p7_maybe_expire(data, run):
+        _game_api_save(data)
+        return 409, {"error": "run_expired", "detail": "lease expired"}
+    if run.get("status") in _P7_TERMINAL_STATES:
+        return 409, {"error": "run_already_terminal",
+                     "detail": "run is " + str(run.get("status"))}
+    if run.get("status") == "UNKNOWN_OUTCOME":
+        # Revision 1 (S1): only muse or the owner may reconcile a
+        # stuck run, and the evidence must name the trace event being
+        # reconciled (action_result_event_id, or
+        # action_started_event_id when the run has no action_result).
+        # A resident token alone can no longer unstick its own run,
+        # and arbitrary evidence ("anything": 1) no longer passes.
+        if agent not in ("muse", "owner"):
+            return 403, {"error": "reconcile_requires_muse",
+                         "detail": "only muse or the owner may reconcile "
+                         "an UNKNOWN_OUTCOME run"}
+        if body.get("reconciled") is not True:
+            return 409, {"error": "reconciliation_required",
+                         "detail": "UNKNOWN_OUTCOME runs need reconciled:true plus evidence"}
+        evidence = body.get("evidence")
+        if not isinstance(evidence, dict) or not evidence:
+            return 400, {"error": "reconciliation requires evidence"}
+        ok, err = _p7_reconcile_evidence(data, resident_id, run, evidence)
+        if not ok:
+            return 400, {"error": "reconciliation_evidence_invalid",
+                         "detail": err}
+    if not _p7_transition_allowed(run, "run_completed"):
