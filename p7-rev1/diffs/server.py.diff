+
+import re as _p7_re
+
+_P7_ID_RE = _p7_re.compile(r"^[A-Za-z0-9_:\-./]{1,128}$")
+
+
+def _p7_is_id(value):
+    return isinstance(value, str) and bool(_P7_ID_RE.match(value))
+
+
+# Revision 1 (Claude audit S7): the only payload shapes the server
+# accepts on POST .../events. Anything else — an unknown key, free
+# text, an oversized int — is 400 event_payload_invalid. This is what
+# makes "structured lessons only" and the canary rule real at the
+# server boundary instead of a client convention.
+_P7_EVENT_SCHEMAS = {
+    "lease_claimed": {"fencing_token": "int"},
+    "memory_loaded": {"entries": "int", "seqs": ["int"]},
+    "goal_proposed": {"goal": {"ref": "id", "kind": "id"}},
+    "goal_accepted": {"goal": {"ref": "id"}},
+    "no_action": {"reason": "id", "job_id": "id"},
+    "plan_proposed": {"plan": {"action": {"type": "id", "job_id": "id"}},
+                      "source": "id", "adapter_output_units": "int"},
+    "plan_rejected": {"reason_code": "id", "adapter_output_units": "int"},
+    "plan_accepted": {"plan": {"action": {"type": "id", "job_id": "id"}}},
+    "action_authorized": {"action": {"type": "id", "job_id": "id"}},
+    "evaluation_recorded": {"dry_run": "bool", "would_claim": "id",
+                            "outcome": "id", "job_id": "id",
+                            "action_result_event_id": "id",
+                            "adapter_output_units": "int"},
+    "lesson_appended": {"lesson_key": "id", "job_id": "id", "seq": "int"},
+}
+
+
+def _p7_validate_event_payload(event_type, payload):
+    """Validate a client event payload against its schema.
+    Returns (ok, error_detail)."""
+    schema = _P7_EVENT_SCHEMAS.get(event_type)
+    if schema is None:
+        return False, "no schema for event type " + event_type
+    if not isinstance(payload, dict):
+        return False, "payload must be an object"
+    for key in payload:
+        if key not in schema:
+            return False, "unknown payload key " + key
+    for key, kind in schema.items():
+        if key not in payload:
+            continue
+        value = payload[key]
+        if kind == "int":
+            if not isinstance(value, int) or isinstance(value, bool) \
+                    or value < 0 or value > 10 ** 9:
+                return False, "payload key " + key + " must be an int 0..1e9"
+        elif kind == "bool":
+            if not isinstance(value, bool):
+                return False, "payload key " + key + " must be a boolean"
+        elif kind == "id":
+            if not _p7_is_id(value):
+                return False, ("payload key " + key + " must be an id "
+                               "(1..128 chars, no free text)")
+        elif isinstance(kind, list) and kind == ["int"]:
+            if (not isinstance(value, list) or len(value) > 100
+                    or not all(isinstance(v, int)
+                               and not isinstance(v, bool) for v in value)):
+                return False, ("payload key " + key + " must be a list of "
+                               "at most 100 ints")
+        elif isinstance(kind, dict):
+            # Nested object (goal / plan / action). "goal" may be None
+            # (no candidate); otherwise only the schema's keys, each
+            # validated the same way.
+            if value is None and key == "goal":
+                continue
+            if not isinstance(value, dict):
+                return False, "payload key " + key + " must be an object"
+            for sub in value:
+                if sub not in kind:
+                    return False, ("unknown payload key " + key + "." + sub)
+            for sub, subkind in kind.items():
+                if sub not in value:
+                    continue
+                subvalue = value[sub]
+                if subkind == "id":
+                    if not _p7_is_id(subvalue):
+                        return False, ("payload key " + key + "." + sub
+                                       + " must be an id")
+                elif subkind == "int":
+                    if (not isinstance(subvalue, int)
+                            or isinstance(subvalue, bool)):
+                        return False, ("payload key " + key + "." + sub
+                                       + " must be an int")
+                elif isinstance(subkind, dict):
+                    if not isinstance(subvalue, dict):
+                        return False, ("payload key " + key + "." + sub
+                                       + " must be an object")
+                    for deep in subvalue:
+                        if deep not in subkind:
+                            return False, ("unknown payload key " + key
+                                           + "." + sub + "." + deep)
+                    for deep, deepkind in subkind.items():
+                        if deep not in subvalue:
+                            continue
+                        if deepkind == "id" and not _p7_is_id(
+                                subvalue[deep]):
+                            return False, ("payload key " + key + "." + sub
+                                           + "." + deep + " must be an id")
+    return True, None
+
+
+class _P7AppendOnlyViolation(Exception):
+    pass
+
+
+class _P7RunStore:
+    """One per-resident append-only trace store. The instance is bound
+    to exactly one resident_id at construction (from the server's lease,
+    never from a caller-supplied value) and refuses every cross-resident
+    operation. Events are hash-chained; UPDATE/DELETE are refused by
+    SQLite triggers (append-only at the DB level, not just by
+    convention). The chain head is anchored into the public event log
+    by the server on EVERY append (rev 1; v1 anchored only at terminal
+    states), so tampering is detectable outside this file's write
+    authority. The hash is a plain sha256 with no key and the anchor
+    lives in game_api.json, same process and same user as the runner:
+    this detects tampering by outsiders, NOT by the runner/server host
+    account. (Claude audit S8.)"""
+
+    def __init__(self, resident_id):
+        if not isinstance(resident_id, str) or not _ECON_RESIDENT_ID_RE.match(resident_id):
+            raise ValueError("bad resident_id for run store")
+        self.resident_id = resident_id
+        base = os.path.dirname(os.path.abspath(__file__))
+        self.path = os.path.join(base, "runs_%s.db" % resident_id)
+        self._conn = sqlite3.connect(self.path, check_same_thread=False)
+        self._conn.execute("PRAGMA journal_mode=WAL")
+        self._conn.execute(
+            "CREATE TABLE IF NOT EXISTS run_events ("
+            " seq INTEGER PRIMARY KEY AUTOINCREMENT,"
+            " run_id TEXT NOT NULL, event_id TEXT UNIQUE NOT NULL,"
+            " event_type TEXT NOT NULL, payload_json TEXT NOT NULL,"
+            " prev_hash TEXT NOT NULL, hash TEXT NOT NULL, ts TEXT NOT NULL)")
+        self._conn.execute(
+            "CREATE TABLE IF NOT EXISTS run_anchors ("
+            " run_id TEXT PRIMARY KEY, head_hash TEXT NOT NULL,"
+            " public_event_id TEXT NOT NULL, ts TEXT NOT NULL)")
+        self._conn.execute(
+            "CREATE TRIGGER IF NOT EXISTS p7_no_update_run_events"
+            " BEFORE UPDATE ON run_events BEGIN"
+            " SELECT RAISE(ABORT, 'run_events append-only'); END")
+        self._conn.execute(
+            "CREATE TRIGGER IF NOT EXISTS p7_no_delete_run_events"
+            " BEFORE DELETE ON run_events BEGIN"
+            " SELECT RAISE(ABORT, 'run_events append-only'); END")
+        self._conn.commit()
+
+    def close(self):
+        try:
+            self._conn.close()
+        except Exception:
+            pass
+
+    def _head(self, run_id):
+        row = self._conn.execute(
+            "SELECT hash FROM run_events WHERE run_id = ?"
+            " ORDER BY seq DESC LIMIT 1", (run_id,)).fetchone()
+        return row[0] if row else "GENESIS"
+
+    def append(self, run_id, event_type, payload):
+        if not isinstance(run_id, str) or not run_id:
+            raise ValueError("run_id required")
+        if event_type not in _P7_RUN_EVENT_TYPES:
+            raise ValueError("unknown run event type: %s" % event_type)
+        if not isinstance(payload, dict):
+            raise ValueError("event payload must be an object")
+        payload = dict(payload)
+        if payload.get("resident_id") not in (None, self.resident_id):
+            raise _P7AppendOnlyViolation(
+                "event resident_id does not match this store")
+        payload["resident_id"] = self.resident_id
+        blob = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+        if len(blob.encode("utf-8")) > _P7_MAX_EVENT_PAYLOAD_BYTES:
+            raise ValueError("event payload too large")
+        ts = _econ_now()
+        prev = self._head(run_id)
+        event_id = "revt-" + _game_uuid.uuid4().hex[:12]
+        h = hashlib.sha256(
+            (prev + "|" + run_id + "|" + event_type + "|" + blob + "|" + ts
+             ).encode("utf-8")).hexdigest()
+        self._conn.execute(
+            "INSERT INTO run_events (run_id, event_id, event_type,"
+            " payload_json, prev_hash, hash, ts) VALUES (?,?,?,?,?,?,?)",
+            (run_id, event_id, event_type, blob, prev, h, ts))
+        self._conn.commit()
+        return {"event_id": event_id, "run_id": run_id,
+                "event_type": event_type, "resident_id": self.resident_id,
+                "prev_hash": prev, "hash": h, "ts": ts,
+                "payload": payload}
+
+    def list_events(self, run_id):
+        rows = self._conn.execute(
+            "SELECT event_id, event_type, payload_json, prev_hash, hash, ts"
+            " FROM run_events WHERE run_id = ? ORDER BY seq ASC",
+            (run_id,)).fetchall()
+        return [{"event_id": r[0], "event_type": r[1],
+                 "payload": json.loads(r[2]), "prev_hash": r[3],
+                 "hash": r[4], "ts": r[5]} for r in rows]
+
+    def verify(self, run_id):
+        """Recompute the chain. Returns (ok, head_hash, count)."""
+        rows = self._conn.execute(
+            "SELECT event_type, payload_json, prev_hash, hash, ts"
+            " FROM run_events WHERE run_id = ? ORDER BY seq ASC",
+            (run_id,)).fetchall()
+        prev = "GENESIS"
+        for et, blob, ph, h, ts in rows:
+            if ph != prev:
+                return False, prev, len(rows)
+            expect = hashlib.sha256(
+                (prev + "|" + run_id + "|" + et + "|" + blob + "|" + ts
+                 ).encode("utf-8")).hexdigest()
+            if expect != h:
+                return False, prev, len(rows)
+            prev = h
+        return True, prev, len(rows)
+
+    def anchor(self, run_id, public_event_id):
+        ok, head, _n = self.verify(run_id)
+        if not ok:
+            raise _P7AppendOnlyViolation("cannot anchor a broken chain")
+        self._conn.execute(
+            "INSERT OR REPLACE INTO run_anchors (run_id, head_hash,"
+            " public_event_id, ts) VALUES (?,?,?,?)",
+            (run_id, head, public_event_id, _econ_now()))
+        self._conn.commit()
+        return {"run_id": run_id, "head_hash": head,
+                "public_event_id": public_event_id}
+
+
+def _p7_now():
+    return datetime.now(timezone.utc)
+
+
+def _p7_run_view(run):
+    """Public run shape. The executor token hash is never returned."""
+    return {k: v for k, v in run.items() if k != "executor_token_sha256"}
+
+
+def _p7_kill_switch_on(data):
+    ks = data.get("run_kill_switch") or {}
+    return bool(ks.get("enabled"))
+
+
+def _p7_spend(data, resident_id):
+    """Persisted per-resident run spend + cooldown, reset at UTC
+    midnight. The counters live in game_api.json so they survive a
+    process restart (unlike in-memory counters). last_action_at is
+    kept across midnight: a cooldown must survive the date change."""
+    spend = data.setdefault("spend", {})
+    # Revision 1 (R5): tokens_today is renamed output_units_today —
+    # the daily ledger counts adapter output units (len // 4), not
+    # measured model tokens. Old records are migrated on read.
+    entry = spend.setdefault(resident_id, {
+        "date": _econ_today_str(), "actions_today": 0,
+        "output_units_today": 0, "last_action_at": None, "runs_today": 0})
+    if "tokens_today" in entry:
+        entry["output_units_today"] = int(entry.pop("tokens_today") or 0)
+    if entry.get("date") != _econ_today_str():
+        entry.update({"date": _econ_today_str(), "actions_today": 0,
+                      "output_units_today": 0, "runs_today": 0})
+    return entry
+
+
+def _p7_find_run(data, resident_id, run_id):
+    run = data.get("runs", {}).get(run_id)
+    if run is None or run.get("resident_id") != resident_id:
+        return None
+    return run
+
+
+def _p7_mint_executor_token():
+    plain = _p7_secrets.token_urlsafe(32)
+    return plain, hashlib.sha256(plain.encode("utf-8")).hexdigest()
+
+
+def _p7_executor_auth(data, run, handler):
+    """Authenticate the per-run executor token (X-Run-Token header).
+    Returns (agent, error_obj) — error_obj None on success. The token
+    is compared by sha256 only; the plain value is never stored or
+    logged, and is returned to the executor exactly once, at run
+    creation. A replay of the creation idempotency key does NOT
+    re-issue the token."""
+    token = (handler.headers.get("X-Run-Token") or "").strip()
+    if not token:
+        return None, {"error": "executor_token_required"}
+    if run is None:
+        return None, {"error": "run not found"}
+    digest = hashlib.sha256(token.encode("utf-8")).hexdigest()
+    if not _game_hmac.compare_digest(
+            digest, str(run.get("executor_token_sha256") or "")):
+        return None, {"error": "executor_token_invalid"}
+    return "executor:" + run["resident_id"], None
+
+
+def _p7_transition_allowed(run, event_type):
+    status = run.get("status")
+    if status in _P7_TERMINAL_STATES:
+        return False
+    if event_type in ("run_blocked", "run_expired", "run_kill_switch"):
+        return True
+    if event_type == "run_completed":
+        return status in ("MEMORY_APPENDED", "EVALUATED", "NO_ACTION",
+                          "UNKNOWN_OUTCOME")
+    return event_type in _P7_ALLOWED_TRANSITIONS.get(status, set())
+
+
+def _p7_lease_expired(run):
+    try:
+        exp = datetime.fromisoformat(run.get("lease_expires_at", ""))
+    except ValueError:
+        return True
+    return _p7_now() >= exp
+
+
+def _p7_anchor_chain_head(data, run):
+    """Anchor the run trace's chain head into the public event log
+    (hash only, never content). The public log is outside the runner's
+    write authority, so a tampered trace is detectable by comparing
+    the recomputed head against the anchored value."""
+    store = _P7RunStore(run["resident_id"])
+    try:
+        ok, head, count = store.verify(run["id"])
+        if not ok:
+            return None
+        ev = _econ_event(data, "resident:" + run["resident_id"],
+                         "run.chain_anchored",
+                         {"run_id": run["id"],
+                          "resident_id": run["resident_id"],
+                          "head_hash": head, "events": count}, None)
+        store.anchor(run["id"], ev["id"])
+        return {"head_hash": head, "public_event_id": ev["id"],
+                "events": count}
+    finally:
+        store.close()
+
+
+def _p7_maybe_expire(data, run):
+    """Lazy expiry: a non-terminal run whose lease passed is expired
+    on first sight, with a trace event + public event + chain anchor.
+    Returns True if the run was expired here. Callers save after.
+    Revision 1 (S2): UNKNOWN_OUTCOME never lazily expires. The lock
+    evaporating on its own was a bypass: only a muse/owner reconcile
+    (complete / block / expire) releases a stuck run."""
+    if run.get("status") in _P7_TERMINAL_STATES:
+        return False
+    if run.get("status") == "UNKNOWN_OUTCOME":
+        return False
+    if not _p7_lease_expired(run):
+        return False
+    store = _P7RunStore(run["resident_id"])
+    try:
+        store.append(run["id"], "run_expired",
+                     {"reason": "lease_expired"})
+    finally:
+        store.close()
+    run["status"] = "EXPIRED"
+    run["updated_at"] = _econ_now()
+    _p7_anchor_chain_head(data, run)
+    _econ_event(data, "resident:" + run["resident_id"], "run.expired",
+                {"run_id": run["id"], "resident_id": run["resident_id"],
+                 "reason": "lease_expired"}, None)
+    return True
+
+def _p7_policy(data, resident_id):
+    """The resident's run policy (S5). Server-held; defaults are the
+    least privilege the P7 contract needs. Missing keys are filled
+    from the defaults so older records stay valid."""
+    policies = data.get("run_policy")
+    if not isinstance(policies, dict):
+        policies = {}
+    raw = policies.get(resident_id)
+    merged = dict(_P7_POLICY_DEFAULTS)
+    if isinstance(raw, dict):
+        for key in merged:
+            if key in raw:
+                merged[key] = raw[key]
+    return merged
+
+
+def _p7_reconcile_evidence(data, resident_id, run, evidence):
+    """Validate reconcile evidence for an UNKNOWN_OUTCOME run (S1).
+    The evidence must name the trace event the human is reconciling:
+    action_result_event_id (the action_result event) or, when the run
+    has no action_result event (crash before the result),
+    action_started_event_id. The referenced event must exist in the
+    run's trace with the matching type. An optional outcome field must
+    be 'committed' or 'not_committed'. Returns (ok, error_detail)."""
+    if not isinstance(evidence, dict):
+        return False, "evidence must be an object"
+    if "action_result_event_id" in evidence:
+        ref_id = evidence.get("action_result_event_id")
+        want_type = "action_result"
+    elif "action_started_event_id" in evidence:
+        ref_id = evidence.get("action_started_event_id")
+        want_type = "action_started"
+    else:
+        return False, ("evidence must name action_result_event_id or "
+                       "action_started_event_id")
+    if not isinstance(ref_id, str) or not ref_id:
+        return False, "the named event id must be a non-empty string"
+    store = _P7RunStore(resident_id)
+    try:
+        events = store.list_events(run["id"])
+    finally:
+        store.close()
+    for ev in events:
+        if ev.get("event_id") == ref_id:
+            if ev.get("event_type") != want_type:
+                return False, ("referenced event is "
+                               + str(ev.get("event_type"))
+                               + ", not " + want_type)
+            break
+    else:
+        return False, "referenced event not found in the run trace"
+    outcome = evidence.get("outcome")
+    if outcome is not None and outcome not in ("committed",
+                                               "not_committed"):
+        return False, "outcome must be committed or not_committed"
+    return True, None
+
+
+def _p7_reconcile_crash_runs(data):
+    """Startup reconcile (S6). A run whose persisted status is
+    ACTION_AUTHORIZED or ACTION_STARTED can only be a crash remnant:
+    in the live flow the intent record (action_started + adapter
+    charge + save) and the result are written inside one request, so
+    no run legitimately rests in those states across requests. The
+    trace (SQLite, committed per append) is the source of truth: an
+    action_result whose outcome the persisted status does not reflect
+    is honoured; action_started without action_result means the claim
+    may or may not have committed -> UNKNOWN_OUTCOME. Returns True if
+    any run changed (the caller persists). Only runs in the
+    crash-window states open a store, so a normal load costs one
+    dict scan."""
+    changed = False
+    for run in list(data.get("runs", {}).values()):
+        if run.get("status") not in ("ACTION_AUTHORIZED",
+                                     "ACTION_STARTED"):
+            continue
+        resident_id = run.get("resident_id")
+        try:
+            store = _P7RunStore(resident_id)
+            try:
+                events = store.list_events(run["id"])
+            finally:
+                store.close()
+        except Exception:
+            continue
+        started = [e for e in events
+                   if e.get("event_type") == "action_started"]
+        if not started:
+            continue
+        results = [e for e in events
+                   if e.get("event_type") == "action_result"]
+        if results:
+            payload = results[-1].get("payload") or {}
+            if payload.get("committed"):
+                run["status"] = "ACTION_EXECUTED"
+            else:
+                run["status"] = "BLOCKED"
+                run["reason_code"] = "action_rejected"
+            run["updated_at"] = _econ_now()
+            changed = True
+        else:
+            run["status"] = "UNKNOWN_OUTCOME"
+            run["reason_code"] = "unknown_outcome"
+            run["updated_at"] = _econ_now()
+            changed = True
+    return changed
+
+
+def _p7_get_run_policy(data, agent, resident_id):
+    if agent not in ("muse", "owner"):
+        return 403, {"error": "admin_only"}
+    if _econ_find_resident(data, resident_id) is None:
+        return 404, {"error": "resident not found"}
+    return 200, {"resident_id": resident_id,
+                 "policy": _p7_policy(data, resident_id),
+                 "policy_version": _P7_POLICY_VERSION}
+
+
+def _p7_set_run_policy(data, agent, resident_id, body):
+    """Muse/owner only. Adjusts the resident's run policy (S5). The
+    policy is the ceiling: a run request may only narrow it."""
+    if agent not in ("muse", "owner"):
+        return 403, {"error": "admin_only"}
+    if _econ_find_resident(data, resident_id) is None:
+        return 404, {"error": "resident not found"}
+    policy = _p7_policy(data, resident_id)
+    if "min_cooldown_ms" in body:
+        value = body["min_cooldown_ms"]
+        if (not isinstance(value, int) or isinstance(value, bool)
+                or value < 0 or value > 3600000):
+            return 400, {"error": "min_cooldown_ms must be an int 0..3600000"}
+        policy["min_cooldown_ms"] = value
+    if "live_enabled" in body:
+        value = body["live_enabled"]
+        if not isinstance(value, bool):
+            return 400, {"error": "live_enabled must be a boolean"}
+        policy["live_enabled"] = value
+    if "allowlist" in body:
+        value = body["allowlist"]
+        if (not isinstance(value, list) or not value
+                or not all(isinstance(a, str) and a in _P7_ACTION_TYPES
+                           for a in value)):
+            return 400, {"error": "allowlist must list action types from "
+                         + ", ".join(_P7_ACTION_TYPES)}
+        policy["allowlist"] = list(value)
+    data.setdefault("run_policy", {})[resident_id] = policy
+    _econ_event(data, "agent:" + agent, "run.policy",
+                {"resident_id": resident_id, "policy": policy}, None)
+    _game_api_save(data)
+    return 200, {"resident_id": resident_id, "policy": policy,
+                 "policy_version": _P7_POLICY_VERSION}
+
+
+def _p7_create_run(data, agent, digest, resident_id, body, handler):
+    if not _econ_write_ok(digest):
+        return 429, {"error": "rate limit", "retry_after_seconds": 60}
+    if _econ_find_resident(data, resident_id) is None:
+        return 404, {"error": "resident not found"}
+    if not _econ_may_act_as(agent, resident_id, data):
+        return 403, {"error": "token_not_bound_to_resident",
+                     "resident_id": resident_id}
+    # Idempotency: the same key returns the same run, never a second
+    # one — and never re-issues the executor token (shown once).
+    # This check runs BEFORE the lease checks: replaying a creation
+    # key is not a new lease, it is the same run.
+    idem = body.get("idempotency_key")
+    if not isinstance(idem, str) or not idem:
+        return 400, {"error": "run requires idempotency_key"}
+    idem_scope = "run:" + resident_id + ":" + idem
+    prev = data.get("run_idempotency", {}).get(idem_scope)
+    if prev is not None:
+        run = _p7_find_run(data, resident_id, prev)
+        if run is not None:
+            return 200, _p7_run_view(run)
+    # A resident in UNKNOWN_OUTCOME cannot start a new run until the
+    # stuck run is reconciled (complete with evidence, or block).
+    for r in data.get("runs", {}).values():
+        if (r.get("resident_id") == resident_id
+                and r.get("status") == "UNKNOWN_OUTCOME"):
+            return 409, {"error": "unknown_outcome_blocked",
+                         "detail": "reconcile run " + r["id"] + " first",
+                         "run_id": r["id"]}
+    # One open lease per resident.
+    for r in data.get("runs", {}).values():
+        if r.get("resident_id") != resident_id:
+            continue
+        if r.get("status") in _P7_TERMINAL_STATES:
+            continue
+        _p7_maybe_expire(data, r)
+        if r.get("status") not in _P7_TERMINAL_STATES:
+            return 409, {"error": "lease_already_open",
+                         "detail": "run " + r["id"] + " holds the lease",
+                         "run_id": r["id"]}
+    # Revision 1 (S4): the policy version is required and enforced
+    # here — the v1 docs claimed this and the code did not do it.
+    policy_version = body.get("policy_version")
+    if policy_version is None:
+        return 400, {"error": "policy_version_required",
+                     "detail": "policy_version " + _P7_POLICY_VERSION
+                     + " is required"}
+    if policy_version != _P7_POLICY_VERSION:
+        return 400, {"error": "policy_version_mismatch",
+                     "detail": "expected " + _P7_POLICY_VERSION}
+    # Revision 1 (S5): limits come from the server-side policy, never
+    # from the request alone. The request may only narrow the policy.
+    policy = _p7_policy(data, resident_id)
+    # Cooldown + daily budgets (persisted; survive restarts). The
+    # effective cooldown is the policy minimum or the client's larger
+    # value, whichever is greater; a client may not ask for less.
+    spend = _p7_spend(data, resident_id)
+    req_cooldown = body.get("cooldown_ms")
+    if (not isinstance(req_cooldown, int)
+            or isinstance(req_cooldown, bool) or req_cooldown < 0):
+        req_cooldown = 0
+    cooldown_ms = max(req_cooldown, int(policy.get("min_cooldown_ms") or 0))
+    if cooldown_ms and spend.get("last_action_at"):
+        try:
+            last = datetime.fromisoformat(spend["last_action_at"])
+            if (_p7_now() - last).total_seconds() * 1000 < cooldown_ms:
+                return 409, {"error": "cooldown_active",
+                             "detail": "last action too recent",
+                             "cooldown_ms": cooldown_ms}
+        except ValueError:
+            pass
+    if int(spend.get("runs_today") or 0) >= _P7_DEFAULT_DAILY_ACTIONS:
+        return 429, {"error": "budget_exceeded",
+                     "detail": "daily run cap reached"}
+    mode = str(body.get("mode", "dry_run")).strip().lower()
+    if mode not in ("dry_run", "live"):
+        return 400, {"error": "mode must be dry_run or live"}
+    # Revision 1 (S5): live mode is a server-side policy flag, not a
+    # client choice. A resident token alone can no longer opt into
+    # live; only muse/owner enabling it in the policy opens the gate.
+    if mode == "live" and not policy.get("live_enabled"):
+        return 403, {"error": "live_not_enabled",
+                     "detail": "live mode is not enabled for this resident"}
+    policy_allowlist = policy.get("allowlist")
+    allowlist = body.get("allowlist")
+    if allowlist is None:
+        allowlist = (list(policy_allowlist) if policy_allowlist
+                     else list(_P7_ACTION_TYPES))
+    if (not isinstance(allowlist, list) or not allowlist
+            or not all(isinstance(a, str) and a in _P7_ACTION_TYPES
+                       for a in allowlist)):
+        return 400, {"error": "allowlist must list action types from "
+                     + ", ".join(_P7_ACTION_TYPES)}
+    if (policy_allowlist is not None
+            and not set(allowlist) <= set(policy_allowlist)):
+        return 400, {"error": "allowlist_exceeds_policy",
+                     "detail": "the request allowlist must be a subset "
+                     "of the resident policy allowlist"}
+    # Revision 1 (S4): run limits are validated and stored on the
+    # record (the v1 docs named them; the v1 code never kept them).
+    max_steps = body.get("max_steps", _P7_DEFAULT_MAX_STEPS)
+    if (not isinstance(max_steps, int) or isinstance(max_steps, bool)
+            or max_steps < 1 or max_steps > _P7_MAX_STEPS):
+        return 400, {"error": "max_steps must be an int 1.."
+                     + str(_P7_MAX_STEPS)}
+    max_wall_ms = body.get("max_wall_ms", _P7_DEFAULT_MAX_WALL_MS)
+    if (not isinstance(max_wall_ms, int) or isinstance(max_wall_ms, bool)
+            or max_wall_ms < 1000 or max_wall_ms > _P7_MAX_WALL_MS):
+        return 400, {"error": "max_wall_ms must be an int 1000.."
+                     + str(_P7_MAX_WALL_MS)}
+    max_model_tokens = body.get("max_model_tokens",
+                                _P7_DEFAULT_MAX_MODEL_TOKENS)
+    if (not isinstance(max_model_tokens, int)
+            or isinstance(max_model_tokens, bool)
+            or max_model_tokens < 0
+            or max_model_tokens > _P7_MAX_MODEL_TOKENS):
+        return 400, {"error": "max_model_tokens must be an int 0.."
+                     + str(_P7_MAX_MODEL_TOKENS)}
+    lease_s = body.get("lease_seconds")
+    if not isinstance(lease_s, int) or lease_s <= 0:
+        lease_s = _P7_DEFAULT_LEASE_SECONDS
+    lease_s = min(lease_s, _P7_MAX_LEASE_SECONDS)
+    fencing = data.setdefault("fencing", {})
+    fencing[resident_id] = int(fencing.get(resident_id) or 0) + 1
+    token_plain, token_sha = _p7_mint_executor_token()
+    now = _p7_now()
+    run = {
+        "id": "run-" + _game_uuid.uuid4().hex[:12],
+        "resident_id": resident_id,
+        "status": "LEASED",
+        "mode": mode,
+        "allowlist": list(allowlist),
+        "fencing_token": fencing[resident_id],
+        "executor_token_sha256": token_sha,
+        "lease_seconds": lease_s,
+        "lease_expires_at": (now + timedelta(seconds=lease_s)).strftime(
+            "%Y-%m-%dT%H:%M:%SZ"),
+        "max_actions": 1,
+        "actions_taken": 0,
+        "adapter_output_units_used": 0,
+        "policy_version": _P7_POLICY_VERSION,
+        "max_steps": max_steps,
+        "max_wall_ms": max_wall_ms,
+        "max_model_tokens": max_model_tokens,
+        "cooldown_ms": cooldown_ms,
+        "reason_code": None,
+        "created_at": _econ_now(),
+        "updated_at": _econ_now(),
+        "created_by_agent": agent,
+    }
+    data.setdefault("runs", {})[run["id"]] = run
+    data.setdefault("run_idempotency", {})[idem_scope] = run["id"]
+    spend["runs_today"] = int(spend.get("runs_today") or 0) + 1
+    store = _P7RunStore(resident_id)
+    try:
+        store.append(run["id"], "run_created",
+                     {"mode": mode, "allowlist": list(allowlist),
+                      "fencing_token": fencing[resident_id],
+                      "lease_seconds": lease_s})
+        store.append(run["id"], "lease_claimed",
+                     {"fencing_token": fencing[resident_id]})
+    finally:
+        store.close()
+    _econ_event(data, "resident:" + resident_id, "run.created",
+                {"run_id": run["id"], "resident_id": resident_id,
+                 "mode": mode, "fencing_token": fencing[resident_id]}, idem)
+    _game_api_save(data)
+    view = _p7_run_view(run)
+    view["executor_token"] = token_plain
+    return 201, view
+
